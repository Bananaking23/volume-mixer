void loadCalibration() {
  prefs.begin("mixer", true);
  for (int i = 0; i < NUM_CHANNELS; i++) {
    char keyMin[8]; char keyMax[8];
    snprintf(keyMin, sizeof(keyMin), "min%d", i);
