bool channelShown(int i) {
  if (i >= 5) return false;
  return CH_VISIBLE[i] && CH_STYLE[i] != 2;
}

void drawChrome() {
  if (SHOW_TITLE && strlen(OLED_TITLE) > 0) {
    u8g2.setFont(u8g2_font_6x10_tf);
    u8g2.drawStr(2, 9, OLED_TITLE);
